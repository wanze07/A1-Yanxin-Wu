{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build all sources",
            "type": "shell",
            "command": "javac",
            "args": [
                "--release",
                "17",
                "-encoding",
                "UTF-8",
                "-Xlint:all",
                "-d",
                "bin",
                "src\\*.java"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$javac"
            ],
            "group": "build"
        },
        {
            "label": "Run front desk (typing)",
            "type": "shell",
            "command": "java",
            "args": [
                "-cp",
                "bin",
                "AppointmentConsole"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Build all sources",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "Run assignment demo (automatic)",
            "type": "shell",
            "command": "java",
            "args": [
                "-cp",
                "bin",
                "AssignmentOne"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Build all sources",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        }
    ]
}
